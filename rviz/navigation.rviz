Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic: /scan
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Topic: /odom
      Value: true
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
